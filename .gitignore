# =============================================================
# happyHealth monorepo — root .gitignore
# Covers: backend (Java/Spring Boot), frontend (Node/Vite/React),
#         ml-service (Python/FastAPI), and common tooling
# =============================================================

# ---------------------------------------------------------------
# Environment & secrets — NEVER commit these
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ---------------------------------------------------------------
# Backend — Java / Maven / Spring Boot
# ---------------------------------------------------------------
backend/target/
backend/*.h2.db
backend/*.trace.db
backend/HELP.md

# Maven wrapper jar (downloaded on demand)
backend/.mvn/wrapper/maven-wrapper.jar

# ---------------------------------------------------------------
# Frontend — Node / npm / Vite / React
# ---------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
frontend/coverage/

# ---------------------------------------------------------------
# ML Service — Python / pip / virtual envs
# ---------------------------------------------------------------
ml-service/__pycache__/
ml-service/**/__pycache__/
ml-service/*.pyc
ml-service/*.pyo
ml-service/.venv/
ml-service/venv/
ml-service/env/
ml-service/.pytest_cache/
ml-service/htmlcov/
ml-service/.coverage
ml-service/dist/
ml-service/build/
ml-service/*.egg-info/

# ---------------------------------------------------------------
# OS generated files
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# IDE / Editor folders
# ---------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ---------------------------------------------------------------
# Logs & runtime artefacts
# ---------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*~
